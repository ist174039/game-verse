# ============================================
# GameVerse — Environment Variables
# ============================================
# Copia este ficheiro para .env e preenche os valores.
# NUNCA cometer o .env no repositório (já está em .gitignore).
# ============================================

# ===== Supabase (obrigatório) =====
# Buscar em: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===== Stripe (obrigatório para pagamentos) =====
# Buscar em: Stripe Dashboard > Developers > API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx

# ===== Supabase Redirect (desenvolvimento local) =====
# URL para onde o Supabase redireciona após confirmação de email
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000

# ===== OAuth Providers =====
# Configuração necessária no Supabase Dashboard:
#   Authentication > Providers > Google    — Client ID + Secret da Google Cloud Console
#   Authentication > Providers > Facebook  — App ID + Secret do Facebook Developers
#   Authentication > Providers > Azure     — Client ID + Secret + Tenant do Entra (Azure AD)
# URLs de redirecionamento a adicionar nos providers:
#   https://<project>.supabase.co/auth/v1/callback
#   http://localhost:3000/auth/callback (desenvolvimento local)
